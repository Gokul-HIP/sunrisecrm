0caf\u0cbf\u0c82\u0ca6 \u0ca6\u0cc0\u0caa\u0cbe\u0cb5\u0cb3\u0cbf\u0caf \u0cb9\u0cbe\u0cb0\u0ccd\u0ca6\u0cbf\u0c95 \u0cb6\u0cc1\u0cad\u0cbe\u0cb6\u0caf\u0c97\u0cb3\u0cc1","","\ud83e\ude94\u2728 \u0ca6\u0cc0\u0caa\u0cbe\u0cb5\u0cb3\u0cbf \u0cb9\u0cac\u0ccd\u0cac\u0ca6 \u0cb9\u0cbe\u0cb0\u0ccd\u0ca6\u0cbf\u0c95 \u0cb6\u0cc1\u0cad\u0cbe\u0cb6\u0caf\u0c97\u0cb3\u0cc1\n\u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cac\u0cc6\u0cb3\u0c95\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cae\u0ca8\u0ca6\u0cb2\u0ccd\u0cb2\u0cc2 \u0cac\u0cc6\u0cb3\u0c97\u0cb2\u0cbf, \u0c85\u0ca8\u0cbe\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0c95\u0ca4\u0ccd\u0ca4\u0cb2\u0cc6 \u0ca6\u0cc2\u0cb0\u0cb5\u0cbe\u0c97\u0cb2\u0cbf! \ud83d\udc9b\n\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd\u200c\u0c95\u0cc7\u0cb0\u0ccd \u0cb5\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0c97\u0cc2 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6\u0cb5\u0cb0\u0cbf\u0c97\u0cc2 \u0ca6\u0cc0\u0caa\u0cbe\u0cb5\u0cb3\u0cbf\u0caf \u0cb6\u0cc1\u0cad\u0cbe\u0cb6\u0caf\u0c97\u0cb3\u0cc1."]],[111,["46337","Tuesday"]],[112,["46338","Wednesday"]],[113,["46339","Thursday"]],[114,["46340","Friday"]],[115,["46341","Saturday"]],[116,["46342","Sunday"]],[117,["46343","Monday"]],[118,["46344","Tuesday"]],[119,["46345","Wednesday","","","Treatment Procedure Explainer","Hook:\n\u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6\u0caf\u0cc7? \u0c85\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0caf\u0cbe\u0cb5 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0c97\u0cca\u0ca4\u0ccd\u0ca4\u0cbe?\nBody:\n\u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0c95\u0cb2\u0ccd\u0cb2\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cbe \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0cc7 PCNL.\nPCNL \u0c85\u0c82\u0ca6\u0cb0\u0cc6 \u0caa\u0cb0\u0ccd\u0c95\u0ccd\u0caf\u0cc1\u0c9f\u0cc7\u0ca8\u0cbf\u0caf\u0cb8\u0ccd \u0ca8\u0cc6\u0cab\u0ccd\u0cb0\u0ccb\u0cb2\u0cbf\u0ca5\u0cca\u0c9f\u0cae\u0cbf.\n\u0c88 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cc6\u0ca8\u0ccd\u0ca8\u0cbf\u0ca8 \u0cad\u0cbe\u0c97\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0ca3\u0ccd\u0ca3 \u0cb0\u0c82\u0ca7\u0ccd\u0cb0\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7 \u0c89\u0caa\u0c95\u0cb0\u0ca3\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf\u0caf\u0cca\u0cb3\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0ca8\u0c82\u0ca4\u0cb0 \u0c95\u0cb2\u0ccd\u0cb2\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ca3\u0ccd\u0ca3 \u0ca4\u0cc1\u0c82\u0ca1\u0cc1\u0c97\u0cb3\u0cbe\u0c97\u0cbf \u0c92\u0ca1\u0cc6\u0ca6\u0cc1 \u0cb9\u0cca\u0cb0\u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0c95\u0c9f\u0ccd \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6 \u0c88 \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1, \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0c97\u0cbe\u0ca4\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca7\u0cb0\u0cbf\u0cb8\u0cbf \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0cc1 \u0cb6\u0cbf\u0cab\u0cbe\u0cb0\u0cb8\u0cc1 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.\nCTA:\n\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd \u0c95\u0cc7\u0cb0\u0ccd \u0ca8 \u0caf\u0cc1\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6 \u0ca4\u0c9c\u0ccd\u0c9e\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf, \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0caf\u0cbf\u0cb0\u0cbf","","\u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6\u0caf\u0cc7? \ud83e\ude7a \u0c85\u0ca6\u0c95\u0ccd\u0c95\u0cc6 PCNL \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0caf\u0cbf\u0cb0\u0cbf!\nPCNL \u0c8e\u0ca8\u0ccd\u0ca8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0c95\u0cb2\u0ccd\u0cb2\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cbe \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0c97\u0cbe\u0ca4\u0ccd\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0c97\u0cc1\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0cc1 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca7\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.\n\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0ccd\u0caf \u0cac\u0cc7\u0ca1! \ud83d\udc99\n\ud83d\udccd \u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd \u0c95\u0cc7\u0cb0\u0ccd \u0ca8 \u0caf\u0cc1\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6 \u0ca4\u0c9c\u0ccd\u0c9e\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf, \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0caf\u0cbf\u0cb0\u0cbf."]],[120,["46346","Thursday"]],[121,["46347","Friday"]],[122,["46348","Saturday"]],[123,["46349","Sunday"]],[124,["46350","Monday"]],[125,["46351","Tuesday"]],[126,["46352","Tuesday"]],[127,["46353","Wednesday","","Storytelling video","Don't Neglect Frequent Fevers","Scene 1 \u2013 Story Introduction\n\u0c95\u0cb3\u0cc6\u0ca6 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb0\u0cbe\u0cb9\u0cc1\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c9c\u0ccd\u0cb5\u0cb0 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca4\u0ccd\u0ca4\u0cc1. \u0c9c\u0ccd\u0cb5\u0cb0 \u0c95\u0ca1\u0cbf\u0cae\u0cc6\u0caf\u0cbe\u0ca6\u0cbe\u0c97 \u0cb8\u0cc1\u0cae\u0ccd\u0cae\u0ca8\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6 \u0c85\u0cb5\u0ca8\u0cc1, \u0caa\u0cc1\u0ca8\u0c83 \u0c9c\u0ccd\u0cb5\u0cb0 \u0cac\u0c82\u0ca6\u0cbe\u0c97\u0cb2\u0cc2 \u0c85\u0cb7\u0ccd\u0c9f\u0cbe\u0c97\u0cbf \u0c97\u0cae\u0ca8 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.\n\u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf\u0ca6 \u0c85\u0cb5\u0ca8 \u0ca4\u0c82\u0c97\u0cbf \u0c97\u0cbe\u0cac\u0cb0\u0cbf\u0c97\u0cca\u0c82\u0ca1\u0cc1, \u0c92\u0c82\u0ca6\u0cc1 \u0ca6\u0cbf\u0ca8 \u0c85\u0cb5\u0ca8\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0cbe\u0c95\u0ccd\u0c9f\u0cb0\u0ccd \u0cac\u0cb3\u0cbf \u0c95\u0cb0\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cb9\u0ccb\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb3\u0cc6.\nScene 2 \u2013 Doctor Consultation\n\u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0cc1 \u0cb0\u0cbe\u0cb9\u0cc1\u0cb2\u0ccd\u200c\u0ca8 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cb5\u0cbf\u0c9a\u0cbe\u0cb0\u0cbf\u0cb8\u0cbf, \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0ca4\u0caa\u0cbe\u0cb8\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ca1\u0cc6\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6. \u0ca8\u0c82\u0ca4\u0cb0, \u0cb8\u0ccb\u0c82\u0c95\u0cbf\u0ca8\u0cbf\u0c82\u0ca6\u0cbe\u0c97\u0cbf \u0c88 \u0cb0\u0cc0\u0ca4\u0cbf \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c9c\u0ccd\u0cb5\u0cb0 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.\nScene 3 \u2013 Awareness Message\n\u0c9c\u0ccd\u0cb5\u0cb0 \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0c95\u0cbe\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c9c\u0ccd\u0cb5\u0cb0 \u0c95\u0ca1\u0cbf\u0cae\u0cc6\u0caf\u0cbe\u0caf\u0cbf\u0ca4\u0cc6\u0c82\u0ca6\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0ca6\u0cc6, \u0c85\u0ca6\u0cb0 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cae\u0cc1\u0c96\u0ccd\u0caf.\nScene 4 \u2013 CTA\n\u0c86\u0c97\u0cbe\u0c97 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5 \u0c9c\u0ccd\u0cb5\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cac\u0cc7\u0ca1\u0cbf.\n\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd \u0c95\u0cc7\u0cb0\u0ccd \u0ca8\u0ca4\u0c9c\u0ccd\u0c9e \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.","","\u0c86\u0c97\u0cbe\u0c97 \u0c9c\u0ccd\u0cb5\u0cb0 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6\u0caf\u0cc7? \ud83e\udd12 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cac\u0cc7\u0ca1\u0cbf!\n\u0c9c\u0ccd\u0cb5\u0cb0 \u0c95\u0ca1\u0cbf\u0cae\u0cc6\u0caf\u0cbe\u0ca6\u0cb0\u0cc2, \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0c85\u0ca6\u0cb0 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cae\u0cc1\u0c96\u0ccd\u0caf. \u0cb8\u0ccb\u0c82\u0c95\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0cb0\u0cc1\u0c95\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0c9c\u0ccd\u0cb5\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0c95\u0cbe\u0cb3\u0c9c\u0cbf \u0cb5\u0cb9\u0cbf\u0cb8\u0cbf. \u2764\ufe0f \u0c9c\u0ccd\u0cb5\u0cb0 \u0caa\u0ca6\u0cc7 \u0caa\u0ca6\u0cc7 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cb0\u0cc6 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.\n\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd \u0c95\u0cc7\u0cb0\u0ccd \u2014 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0cb5\u0cc7 \u0ca8\u0cae\u0ccd\u0cae \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6. \ud83d\udc99"]],[128,["46354","Thursday"]],[129,