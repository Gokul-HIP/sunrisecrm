ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd\u200c\u0c95\u0cc7\u0cb0\u0ccd\u200c\u0ca8 \u0ca1\u0cbe. \u0c9c\u0c97\u0ca6\u0cc0\u0cb6\u0ccd \u0c9f\u0cbf.\u0c8e\u0cb8\u0ccd., \u0c95\u0ca8\u0ccd\u0cb8\u0cb2\u0ccd\u0c9f\u0cc6\u0c82\u0c9f\u0ccd \u0caf\u0cc1\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0c82\u0ca1\u0ccd\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0ccd, BPH\u200c\u0ca8 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5 \u0cae\u0cb9\u0ca4\u0ccd\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6.\n\n\u0c87\u0c82\u0ca4\u0cb9 \u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cb0\u0cc6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0ca6\u0cc6, \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0cb8\u0cb2\u0cb9\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd\u200c\u0c95\u0cc7\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf."]],[77,["46307","Monday","","","Doctor video (Dr. Jagadeesh T.S)","","","\u0caa\u0ccd\u0cb0\u0cbe\u0cb8\u0ccd\u0c9f\u0cc7\u0c9f\u0ccd \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0c86\u0caa\u0cb0\u0cc7\u0cb7\u0ca8\u0ccd \u0c92\u0c82\u0ca6\u0cc7 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0\u0cb5\u0cc7?\n\nBPH (Benign Prostate Enlargement) \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cb0\u0cbf\u0c97\u0cc2 \u0cb6\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0cb9\u0c82\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c9c\u0cc0\u0cb5\u0ca8\u0cb6\u0cc8\u0cb2\u0cbf\u0caf \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c94\u0cb7\u0ca7\u0cbf\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0ca4\u0cc0\u0cb5\u0ccd\u0cb0\u0cb5\u0cbe\u0ca6\u0cbe\u0c97 \u0c85\u0ca5\u0cb5\u0cbe \u0ca4\u0cca\u0ca1\u0c95\u0cc1\u0c97\u0cb3\u0cc1 \u0c89\u0c82\u0c9f\u0cbe\u0ca6\u0cbe\u0c97 \u0cb6\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb2\u0cc7\u0cb8\u0cb0\u0ccd \u0cb6\u0cb8\u0ccd\u0ca4\u0ccd\u0cb0\u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0cc1 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0c9a\u0cc7\u0ca4\u0cb0\u0cbf\u0c95\u0cc6\u0caf \u0cb8\u0cae\u0caf\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.\n\n\u0c88 \u0c95\u0cc1\u0cb0\u0cbf\u0ca4\u0cc1 \u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd\u200c\u0c95\u0cc7\u0cb0\u0ccd\u200c\u0ca8 \u0ca1\u0cbe. \u0c9c\u0c97\u0ca6\u0cc0\u0cb6\u0ccd \u0c9f\u0cbf.\u0c8e\u0cb8\u0ccd. (Dr. Jagadeesh T.S.), \u0c95\u0ca8\u0ccd\u0cb8\u0cb2\u0ccd\u0c9f\u0cc6\u0c82\u0c9f\u0ccd \u0caf\u0cc1\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c86\u0c82\u0ca1\u0ccd\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf\u0cb8\u0ccd\u0c9f\u0ccd, \u0caa\u0ccd\u0cb0\u0cbe\u0cb8\u0ccd\u0c9f\u0cc7\u0c9f\u0ccd \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cbe \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c97\u0cb3 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6."]],[78,["46308","Tuesday"]],[79,["46309","Wednesday"]],[80,["46310","Thursday"]],[81,["46311","Friday"]],[82,["46312","Saturday"]],[83,["46313","Sunday"]],[84,["46314","Monday"]],[85,["46315","Tuesday"]],[86,["46315","Tuesday Dasara \/ Vijayasdashami","","","Vijayadashami \u2013 The Victory of Health & Healing","\u0ca4\u0cbe\u0caf\u0cbf \u0c9a\u0cbe\u0cae\u0cc1\u0c82\u0ca1\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbf\u0caf \u0c95\u0cc3\u0caa\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0cc6\u0cb2\u0ccd\u0cb2\u0cb0 \u0cae\u0cc7\u0cb2\u0cbf\u0cb0\u0cb2\u0cbf\n\u0cb8\u0cae\u0cb8\u0ccd\u0ca4 \u0c9c\u0ca8\u0ca4\u0cc6\u0c97\u0cc6 \n\u0ca8\u0cbe\u0ca1 \u0cb9\u0cac\u0ccd\u0cac \u0ca6\u0cb8\u0cb0\u0cbe \u0cb9\u0cbe\u0c97\u0cc1 \u0cb5\u0cbf\u0c9c\u0caf \u0ca6\u0cb6\u0cae\u0cbf\u0caf \u0cb9\u0cbe\u0cb0\u0ccd\u0ca6\u0cbf\u0c95 \u0cb6\u0cc1\u0cad\u0cbe\u0cb6\u0caf\u0c97\u0cb3\u0cc1","","\u0ca8\u0cbe\u0ca1 \u0cb9\u0cac\u0ccd\u0cac\u0ca6 \u0cb8\u0c82\u0cad\u0ccd\u0cb0\u0cae \u0cae\u0ca8\u0cc6-\u0cae\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0c82\u0ca4\u0cb8, \u0ca8\u0cc6\u0cae\u0ccd\u0cae\u0ca6\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0cc3\u0ca6\u0ccd\u0ca7\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc1\u0c82\u0cac\u0cb2\u0cbf.\n\u0ca4\u0cbe\u0caf\u0cbf \u0c9a\u0cbe\u0cae\u0cc1\u0c82\u0ca1\u0cc7\u0cb6\u0ccd\u0cb5\u0cb0\u0cbf\u0caf \u0c86\u0cb6\u0cc0\u0cb0\u0ccd\u0cb5\u0cbe\u0ca6 \u0cb8\u0ca6\u0cbe \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0cae\u0cc7\u0cb2\u0cbf\u0cb0\u0cb2\u0cbf. \ud83d\ude4f\u2728\n\u0ca6\u0cb8\u0cb0\u0cbe \u0cb9\u0cbe\u0c97\u0cc2 \u0cb5\u0cbf\u0c9c\u0caf\u0ca6\u0cb6\u0cae\u0cbf\u0caf \u0cb9\u0cbe\