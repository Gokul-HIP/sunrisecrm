u0cc1, \u0cae\u0cc2\u0ca4\u0ccd\u0cb0 \u0cb5\u0cbf\u0cb8\u0cb0\u0ccd\u0c9c\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0c89\u0cb0\u0cbf, \u0cae\u0cc2\u0ca4\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb0\u0c95\u0ccd\u0ca4 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c87\u0ca6\u0cb0 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0cc1.\n\u0ca4\u0cbe\u0caf\u0cbf:\n\u0c87\u0c82\u0ca4\u0cb9 \u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cb0\u0cc6 \u0c8f\u0ca8\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc1 \u0ca1\u0cbe\u0c95\u0ccd\u0c9f\u0ccd\u0cb0\u0cc7?\n\u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0cc1:\n\u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cac\u0cc7\u0ca1\u0cbf. \u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0ca4\u0caa\u0cbe\u0cb8\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.\nCTA \u2013 On-screen text:\n\u0cae\u0c95\u0ccd\u0c95\u0cb3 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0c95\u0cbe\u0cb3\u0c9c\u0cbf \u0cb5\u0cb9\u0cbf\u0cb8\u0cbf.","","\u0cae\u0c95\u0ccd\u0c95\u0cb3\u0cb2\u0ccd\u0cb2\u0cc2 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cc1! \n\u0cb9\u0cca\u0c9f\u0ccd\u0c9f\u0cc6 \u0ca8\u0ccb\u0cb5\u0cc1, \u0cae\u0cc2\u0ca4\u0ccd\u0cb0 \u0cb5\u0cbf\u0cb8\u0cb0\u0ccd\u0c9c\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0c89\u0cb0\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cc2\u0ca4\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb0\u0c95\u0ccd\u0ca4 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0c