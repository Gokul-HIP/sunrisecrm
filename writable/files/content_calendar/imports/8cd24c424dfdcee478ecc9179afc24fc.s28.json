b0\u0cbf\u0ca3\u0cbe\u0cae\u0c95\u0cbe\u0cb0\u0cbf \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0cb2\u0cad\u0ccd\u0caf.\n\n\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c9c\u0ccd\u0c9e \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.\n\n#MetroHospital #ChildHealth #Hernia #PediatricSurgery #HealthyChildren #MetroCare"]],[8,["46218","","","Doctor animation video","Kidney stone removal procedure","Hook: \"\u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0cb0\u0ccd\u0c9c\u0cb0\u0cbf\u0caf\u0cc7 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0 \u0c85\u0c82\u0ca4 \u0c85\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe?\"\nDoctor: \"\u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb8\u0cb0\u0ccd\u0c9c\u0cb0\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0ca6 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0cc2 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6.\"\n\"\u0c85\u0c82\u0ca4\u0cb9 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cca\u0c82\u0ca6\u0cc1 SWL \u2013 Shock Wave Lithotripsy.\"\n\n\"SWL \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0cc7\u0cb9\u0ca6 \u0cb9\u0cca\u0cb0\u0c97\u0cbf\u0ca8\u0cbf\u0c82\u0ca6 \u0cb6\u0cbe\u0c95\u0ccd \u0cb5\u0cc7\u0cb5\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf, \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ca3\u0ccd\u0ca3 \u0ca4\u0cc1\u0c82\u0ca1\u0cc1\u0c97\u0cb3\u0cbe\u0c97\u0cbf \u0caa\u0cc1\u0ca1\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\"\n\"\u0ca8\u0c82\u0ca4\u0cb0 \u0c86 \u0cb8\u0ca3\u0ccd\u0ca3 \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0ca4\u0cc1\u0c82\u0ca1\u0cc1\u0c97\u0cb3\u0cc1 \u0cb8\u0cb9\u0c9c\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cc2\u0ca4\u0ccd\u0cb0\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0cca\u0cb0\u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.\"\n\n\ud83d\udcfa On-Screen Text\nSWL\nShock Wave Lithotripsy\n\n\ud83d\udc68\u200d\u2695\ufe0f Doctor\n\"\u0c86\u0ca6\u0cb0\u0cc6 \u0c88 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cb0\u0cbf\u0c97\u0cc2 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c95\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0c97\u0cbe\u0ca4\u0ccd\u0cb0, \u0c85\u0ca6\u0cc1 \u0c87\u0cb0\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3 \u0cb9\u0cbe\u0c97\u0cc2 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0\u0cb5\u0cc7 SWL \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cc7 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\"\n\n\ud83d\udccd CTA\n\"\u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd\u200c\u0ca8 \u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cb0\u0cc6 \u0ca4\u0ca1 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0ca1\u0cbf. \u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd \u0c95\u0cc7\u0cb0\u0ccd \u0ca8 \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cbf \u0caf\u0cc1\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf \u0ca4\u0c9c\u0ccd\u0c9e\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cad\u0cc7\u0c9f\u0cbf \u0cae\u0cbe\u0ca1\u0cbf. \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0caa\u0ca1\u0cc6\u0ca6\u0cc1 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0c95\u0cb0 \u0c9c\u0cc0\u0cb5\u0ca8\u0ca6\u0ca4\u0ccd\u0ca4 \u0cb9\u0cc6\u0c9c\u0ccd\u0c9c\u0cc6 \u0c87\u0ca1\u0cbf.","Reference for content type: https:\/\/www.instagram.com\/p\/DTsNLLpEt2w\/","\u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd \u0c85\u0c82\u0ca6\u0ccd\u0cb0\u0cc6 \u0c95\u0ca1\u0ccd\u0ca1\u0cbe\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cb0\u0ccd\u0c9c\u0cb0\u0cbf\u0caf\u0cc7 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0 \u0c8e\u0c82\u0ca6\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c85\u0c82\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe?\n\u0c85\u0ca6\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cb0\u0cbf\u0c97\u0cc2 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c87\u0c82\u0ca6\u0cbf\u0ca8 \u0c86\u0ca7\u0cc1\u0ca8\u0cbf\u0c95 \u0cb5\u0cc8\u0ca6\u0ccd\u0caf\u0c95\u0cc0\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 SWL (Shock Wave Lithotripsy) \u0c8e\u0c82\u0cac \u0caa\u0cb0\u0cbf\u0ca3\u0cbe\u0cae\u0c95\u0cbe\u0cb0\u0cbf \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0c88 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb6\u0cbe\u0c95\u0ccd \u0cb5\u0cc7\u0cb5\u0ccd\u200c\u0c97\u0cb3 \u0cb8\u0cb9\u0cbe\u0caf\u0ca6\u0cbf\u0c82\u0ca6 \u0c95\u0cb2\u0ccd\u0cb2\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ca3\u0ccd\u0ca3 \u0ca4\u0cc1\u0c82\u0ca1\u0cc1\u0c97\u0cb3\u0cbe\u0c97\u0cbf \u0caa\u0cc1\u0ca1\u0cbf \u0cae\u0cbe\u0ca1\u0cbf, \u0c85\u0cb5\u0cc1 \u0cb8\u0cb9\u0c9c\u0cb5\u0cbe\u0c97\u0cbf \u0cae\u0cc2\u0ca4\u0ccd\u0cb0\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0cca\u0cb0\u0cb9\u0ccb\u0c97\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0c86\u0ca6\u0cb0\u0cc6, SWL \u0c8e\u0cb2\u0ccd\u0cb2\u0cb0\u0cbf\u0c97\u0cc2 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0c85\u0cb2\u0ccd\u0cb2. \u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd\u200c\u0ca8 \u0c97\u0cbe\u0ca4\u0ccd\u0cb0, \u0c85\u0ca6\u0cc1 \u0c87\u0cb0\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3 \u0cb9\u0cbe\u0c97\u0cc2 \u0cb0\u0ccb\u0c97\u0cbf\u0caf \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0ca6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0\u0cb5\u0cc7 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\u0c88 \u0cb5\u0cbf\u0ca1\u0cbf\u0caf\u0ccb\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf SWL \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0caf\u0cbe\u0cb0\u0cbf\u0c97\u0cc6 \u0c87\u0ca6\u0cc1 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c8f\u0c95\u0cc6 \u0cae\u0cc1\u0c96\u0ccd\u0caf \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.\n\u0c95\u0cbf\u0ca1\u0ccd\u0ca8\u0cbf \u0cb8\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd\u200c\u0ca8 \u0cb2\u0c95\u0ccd\u0cb7\u0ca3\u0c97\u0cb3\u0cbe\u0ca6 \u0cac\u0cc6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb9\u0cca\u0c9f\u0ccd\u0c9f\u0cc6\u0caf \u0ca4\u0cc0\u0cb5\u0ccd\u0cb0 \u0ca8\u0ccb\u0cb5\u0cc1, \u0cae\u0cc2\u0ca4\u0ccd\u0cb0 \u0cb5\u0cbf\u0cb8\u0cb0\u0ccd\u0c9c\u0ca8\u0cc6 \u0cb5\u0cc7\u0cb3\u0cc6 \u0c89\u0cb0\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cc2\u0ca4\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb0\u0c95\u0ccd\u0ca4 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cb0\u0cc6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0ccd\u0caf \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0ca1\u0cbf.\nMetro United Healthcare\u0ca8 \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cbf \u0caf\u0cc1\u0cb0\u0cbe\u0cb2\u0c9c\u0cbf \u0ca4\u0c9c\u0ccd\u0c9e\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cad\u0cc7\u0c9f\u0cbf \u0cae\u0cbe\u0ca1\u0cbf, \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cb0\u0ccb\u0c97\u0ca8\u0cbf\u0cb0\u0ccd\u0ca3\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf."]],[10,["Auguts 15","Independence Day","","Ai video","\u0ca8\u0cae\u0ccd\u0cae \u0cad\u0cbe\u0cb0\u0ca4, \u0ca8\u0cae\u0ccd\u0cae \u0c95\u0ca5\u0cc6","\u201c\u0cb8\u0ccd\u0cb5\u0cbe\u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0ccd\u0caf\u0ca6 \u0caa\u0caf\u0ca3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u2026\n \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cc1 \u0c9c\u0cc0\u0cb5\u0cb5\u0cc2 \u0c85\u0cae\u0cc2\u0cb2\u0ccd\u0caf.\u201d\nScene 2\n\u201c\u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf\u0c95\u0cb0 \u0cac\u0ca6\u0cc1\u0c95\u0cc7\n \u0ca8\u0cae\u0ccd\u0cae \u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0ca6 \u0cb8\u0c82\u0caa\u0ca4\u0ccd\u0ca4\u0cc1.\u201d\n\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0ccb \u0caf\u0cc1\u0ca8\u0cc8\u0c9f\u0cc6\u0ca1\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0ca4\u0ccd \u0c95\u0cc7\u0cb0\u0ccd \u0cb5\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6\n \u0cb8\u0ccd\u0cb5\u0cbe\u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0ccd\u0caf \u0ca6\u0cbf\u0ca8\u0ca6 \u0cb9\u0cbe\u0cb